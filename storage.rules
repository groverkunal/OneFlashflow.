rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload to the 'uploads' folder if they are authenticated.
    // The {userId} wildcard ensures users can only write to their own subfolder.
    // You might want to adjust this based on your user authentication strategy.
    match /uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Add other rules as needed
  }
}
